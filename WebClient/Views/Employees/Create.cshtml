@model EmployeeDTOs
<div class="container mt-2">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Create Employee</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-md-6 border-end">
                        <h5 class="text-primary pb-2 border-bottom">Basic Information</h5>
                        <div class="form-group mb-2">
                            <label asp-for="EmployeeName" class="form-label"></label>
                            <input asp-for="EmployeeName" class="form-control" required />
                        </div>
                        <div class="form-check mb-2">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">Currently Active</label>
                        </div>
                        <div class="form-group mb-2">
                            <label asp-for="JoinDate" class="form-label"></label>
                            <input asp-for="JoinDate" class="form-control" required />
                        </div>
                        <div class="form-group mb-2">
                            <img id="imagePreview" src="/images/noimage.png" class="img-thumbnail" height="120" width="120" /><br />
                            <label for="processFile">Profile Picture</label>
                            <input id="processFile" asp-for="ImageFile" type="file" class="form-control" accept="image/*" onchange="previewImage(this)" style="visibility:hidden" />
                        </div>
                    </div>
                    <div class="col-md-6 border-end">

                        <partial name="_Experienceeditor" model="ViewBag.ExperienceTitles"></partial>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-success">Save</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        function previewImage(input){
            if(input.files && input.files[0]){
                const reader= new FileReader();
                reader.onload= e=> document.getElementById("imagePreview").src=e.target.result;
                reader.readAsDataURL(input.files[0])
            }
        }
    </script>
}